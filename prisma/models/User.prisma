 model User {
  id        Int       @id @default(autoincrement())
  username  String?   @unique
  name      String
  email     String    @unique
  avatar    String?
  phoneNumber    String?
  referralCode     String?       @unique
  referredById     Int?
  referralPoints   Int           @default(0) // Field to track referral points
  referralCount Int @default(0)
  lastLogin DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime  @default(now())
  
  referredBy       User?         @relation("UserReferrals", fields: [referredById], references: [id])
  referrals        User[]        @relation("UserReferrals")
  friends   Friends[]  @relation("UserFriends")
  beFriends Friends[]  @relation("Friendships")
  expenses  UserExpense[]
  participantSplits    SplitUser[]
  createdSplits    Split[]  @relation("CreatedSplits")  // Relation field for splits created by the user
  auth           UserAuth?  @relation("UserAuthRelation")


  @@index([email])
  @@index([id])
  @@index([createdAt])
  @@map("user")
}


model UserAuth {
  userId         Int       @id
  password       String?
  
  // Relation field back to User
  user           User      @relation("UserAuthRelation", fields: [userId], references: [id]) 
  @@map("user_auth")

}